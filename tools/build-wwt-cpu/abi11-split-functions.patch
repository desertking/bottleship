+
+impl SplitPlan {
+    fn new(f: &Function, analysis: &Analysis, limit: usize, first_part: u32) -> Option<Self> {
+        let mut parts = Vec::new();
+        let mut current = Vec::new();
+        let mut weight = 0;
+        let mut destination = vec![(0, 0); f.blocks.len()];
+        for id in f.rpo() {
+            let block = &f.blocks[id as usize];
+            let block_weight = block.insts.len()
+                + 1
+                + match &block.term {
+                    Term::Switch { targets, .. } => targets.len(),
+                    _ => 0,
+                };
+            if !current.is_empty() && weight + block_weight > limit {
+                parts.push(std::mem::take(&mut current));
+                weight = 0;
+            }
+            destination[id as usize] = (parts.len(), current.len() as u32);
+            current.push(id);
+            weight += block_weight;
+        }
+        if parts.is_empty() {
+            return None;
+        }
+        parts.push(current);
+        let mut carried = vec![false; f.vtypes.len()];
+        for part in &parts {
+            for &id in part {
+                let block = &f.blocks[id as usize];
+                for inst in &block.insts {
+                    if let Some(v) = inst.dst.filter(|&v| v < NUM_STATE) {
+                        carried[v as usize] = true;
+                    }
+                    for v in inst.op.uses().into_iter().filter(|&v| v < NUM_STATE) {
+                        carried[v as usize] = true;
+                    }
+                }
+                for v in block.term.uses().into_iter().filter(|&v| v < NUM_STATE) {
+                    carried[v as usize] = true;
+                }
+                for target in block.term.successors() {
+                    if destination[id as usize].0 == destination[target as usize].0 {
+                        continue;
+                    }
+                    for &v in &analysis.global[NUM_STATE as usize..] {
+                        carried[v as usize] |= analysis.is_live_in(target, v);
+                    }
+                }
+            }
+        }
+        let payload: Vec<V> = carried
+            .iter()
+            .enumerate()
+            .filter_map(|(v, &carry)| (carry && v != CPU as usize).then_some(v as V))
+            .collect();
+        if payload.len() > 96 {
+            return None;
+        }
+        Some(Self {
+            parts,
+            destination,
+            payload,
+            first_part,
+        })
+    }
+}
